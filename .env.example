# Database (Postgres) — e.g. from Supabase, Neon, Railway, or local Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/tattoo_platform"

# Gemini API — for AI image analysis (style detection, complexity, time estimate)
GEMINI_API_KEY="..."

# Session signing secret — used to sign the artist login session cookie
SESSION_SECRET="a long random string, e.g. `openssl rand -hex 32`"

# Encrypts Google Calendar refresh tokens at rest — must be exactly 32 bytes
# (64 hex chars), e.g. `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY="..."

# Google OAuth — lets an artist connect their Google Calendar so busy times
# block bookable slots. See SETUP.md for how to get these from Google Cloud
# Console. Leave blank to skip — the feature stays hidden until these are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — transactional email (submission received, booking confirmation, etc)
RESEND_API_KEY="re_..."
# Optional — defaults to onboarding@resend.dev (works for testing, no domain
# setup needed). Set this once you've verified your own sending domain.
RESEND_FROM_EMAIL=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
